    "unit": ""
   },
   "run": {
    "label": "Run command (empty: the built program)",
    "default": "",
    "unit": ""
   }
  },
  "metrics": {
   "instructions": "instr",
   "d1_misses": "misses",
   "ll_misses": "misses",
   "branch_mispredicts": "mispredicts"
  },
