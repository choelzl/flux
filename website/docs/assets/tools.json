  "helper_module": "champsim",
  "helper": true
 },
 {
  "id": "champsim-check",
  "role": "check",
  "title": "Smoke-run the prefetcher",
  "what": "Builds the prefetcher and runs it on one trace; refused when it issues no prefetches.",
  "run": "fluxhelper champsim check {artifact} --traces {traces}",
  "params": {
   "traces": {
    "label": "Trace folder",
    "default": "{home}/traces",
    "unit": ""
   }
  },
  "needs": [
   "pythia"
  ],
  "pass": "passes when it prints `0 failing`; exit 3 = did not build",
  "languages": [
   "cpp"
  ],
  "kinds": [
   "champsim"
  ],
  "short": "smoke",
  "helper_module": "champsim",
  "helper": true
 },
 {
  "id": "champsim-run",
  "role": "stage",
  "title": "Simulate on your traces (ChampSim)",
  "what": "Runs an .ini or a prefetcher header on every trace; the geometric-mean IPC speed-up over no prefetcher.",
  "run": "fluxhelper champsim run {artifact} --traces {traces} --warmup {warmup} --sim {sim}",
  "params": {
   "traces": {
    "label": "Trace folder",
    "default": "{home}/traces",
    "unit": ""
   },
   "warmup": {
    "label": "Warm-up",
    "default": 10000000,
    "unit": "instructions"
   },
   "sim": {
    "label": "Simulated",
    "default": 15000000,
    "unit": "instructions"
   }
  },
  "metrics": {
   "geomean_speedup": ""
  },
  "needs": [
   "pythia"
  ],
  "languages": [
   "ini",
   "cpp"
  ],
  "kinds": [
   "champsim"
  ],
  "short": "sim",
  "helper_module": "champsim",
  "helper": true
 },
