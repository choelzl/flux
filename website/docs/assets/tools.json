 {
  "id": "rtl-stat",
  "role": "stage",
  "title": "Area and cells, Yosys alone (ASAP7)",
  "what": "Yosys maps to ASAP7 cells and sums their liberty area; nothing timed: a second or two, the cheapest screen.",
  "run": "flux rtl measure {artifact} --stage stat --clock-ps {clock_ps}",
  "params": {
   "clock_ps": {
    "label": "Clock period (the mapper's target)",
    "default": 1000,
    "unit": "ps"
   }
  },
  "metrics": {
   "area_um2": "um2",
   "cell_count": "cells"
  },
  "needs": [
   "yosys"
  ],
  "languages": [
   "systemverilog",
   "verilog"
  ],
  "kinds": [
   "rtl"
  ]
 },
