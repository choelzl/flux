 {
  "id": "prog-size",
  "role": "stage",
  "title": "Program size",
  "what": "Builds the program and reads its sections with `size`: text, data and bss bytes.",
  "run": "fluxhelper prog size --build \"{build}\"",
  "params": {
   "build": {
    "label": "Build command ({out}: the program)",
    "default": "c++ -O2 -o {out} {artifact}",
    "unit": ""
   }
  },
  "metrics": {
   "text_bytes": "B",
   "data_bytes": "B",
   "bss_bytes": "B"
  },
  "needs": [
   "size"
  ],
  "infer_needs": true,
  "languages": [
   "c",
   "cpp",
   "python"
  ],
  "kinds": [
   "program",
   "python"
  ],
  "short": "size",
  "helper_module": "prog",
  "helper": true
 },
 {
  "id": "prog-time",
  "role": "stage",
  "title": "Program run time",
  "what": "Builds the program and times it over several runs (hyperfine when present).",
  "run": "fluxhelper prog time --build \"{build}\" --run \"{run}\" --runs {runs} --warmup {warmup}",
  "params": {
   "build": {
    "label": "Build command ({out}: the program)",
    "default": "c++ -O2 -o {out} {artifact}",
    "unit": ""
   },
   "run": {
    "label": "Run command (empty: the built program)",
    "default": "",
    "unit": ""
   },
   "runs": {
    "label": "Runs",
    "default": 10,
    "unit": ""
   },
   "warmup": {
    "label": "Warm-up runs",
    "default": 1,
    "unit": ""
   }
  },
  "metrics": {
   "time_ms": "ms",
   "time_ms_stddev": "ms",
   "time_ms_min": "ms"
  },
  "needs": [],
  "languages": [
   "c",
   "cpp",
   "python"
  ],
  "kinds": [
   "program",
   "python"
  ],
  "short": "time",
  "helper_module": "prog",
  "helper": true
 },
 {
