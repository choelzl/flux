 {
  "id": "python-bench",
  "role": "stage",
  "title": "Time a Python function",
  "what": "Loads the design, calls one function with your arguments, times it over several runs.",
  "run": "fluxhelper bench {artifact} --call {call} --args {args} --runs {runs}",
  "params": {
   "call": {
    "label": "Function",
    "default": "main",
    "unit": ""
   },
   "args": {
    "label": "Arguments (a Python literal)",
    "default": "()",
    "unit": ""
   },
   "runs": {
    "label": "Runs",
    "default": 5,
    "unit": ""
   }
  },
  "metrics": {
   "time_ms": "ms"
  },
  "needs": [],
  "languages": [
   "python"
  ],
  "kinds": [
   "python"
  ],
  "short": "bench",
  "helper_module": "bench",
  "helper": true
 },
 {
  "id": "champsim-build",
