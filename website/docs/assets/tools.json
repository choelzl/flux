[
 {
  "id": "rtl-lint",
  "role": "check",
  "title": "Lint for hardware defects",
  "what": "Verilator lint: latches, multiple drivers, combinational loops, `<=` in combinational logic, implicit nets.",
  "run": "flux rtl lint {artifact}",
  "params": {},
  "needs": [
   "verilator"
  ],
  "pass": "passes with no defect; exit 3 = does not parse",
  "languages": [
